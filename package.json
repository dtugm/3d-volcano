{
  "name": "dt-volcano",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "copy-maplibre": "cpx \"node_modules/maplibre-gl/dist/maplibre-gl-{worker,shared}.mjs\" public/maplibre",
    "dev": "pnpm run copy-maplibre && next dev --turbopack",
    "build": "pnpm run copy-maplibre && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "pnpm run copy-maplibre"
  },
  "dependencies": {
    "3d-tiles-renderer": "0.5.3",
    "geotiff": "^3.0.5",
    "maplibre-gl": "6.11.2",
    "next": "16.1.4",
    "next-themes": "^0.4.6",
    "playcanvas": "^2.23.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swr": "^2.4.1",
    "three": "^0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "cpx2": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
